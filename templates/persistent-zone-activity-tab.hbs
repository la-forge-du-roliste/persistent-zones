<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
<div class="persistent-zone-activity">
  <fieldset class="persistent-zone-activity__section persistent-zone-activity__presets">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Presets.Section"}}</legend>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Presets.Label"}}</label>
      <div class="form-fields">
        <select data-pz-preset-select>
          <option value="">{{localize "PERSISTENT_ZONES.Activity.Presets.Select"}}</option>
          {{#each persistentZonePresetGroups as |group|}}
          <optgroup label="{{localize group.label}}">
            {{#each group.presets as |preset|}}
              <option value="{{preset.id}}" {{#if preset.selected}}selected{{/if}}>{{preset.name}}</option>
            {{/each}}
          </optgroup>
          {{/each}}
        </select>
        <button type="button" data-pz-apply-preset {{#unless persistentZoneSelectedPreset}}disabled{{/unless}}>
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
          {{localize "PERSISTENT_ZONES.Activity.Presets.Apply"}}
        </button>
      </div>
      <p class="hint" data-pz-preset-summary>{{#if persistentZoneSelectedPreset}}{{persistentZoneSelectedPreset.description}}{{else}}{{localize "PERSISTENT_ZONES.Activity.Presets.SelectHint"}}{{/if}}</p>
    </div>
  </fieldset>
  <fieldset class="persistent-zone-activity__section">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Configuration"}}</legend>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.UI.Fields.Enabled"}}</label>
      <input type="checkbox" name="persistentZone.enabled" data-pz-toggle-source="pz-enabled" {{#if persistentZone.enabled}}checked{{/if}}>
      <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.ActivityConfig"}}</p>
    </div>
  </fieldset>

  <div data-pz-toggle-target="pz-enabled">
  <fieldset class="persistent-zone-activity__section">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Placement"}}</legend>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.ZonePlacement"}}</label>
      <select name="persistentZone.placement.mode">
        <option value="fixed" {{#if (eq persistentZone.placement.mode "fixed")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.PlacementModes.Fixed"}}</option>
        <option value="attached-source" {{#if (eq persistentZone.placement.mode "attached-source")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.PlacementModes.AttachedSource"}}</option>
      </select>
      <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.ZonePlacement"}}</p>
    </div>
  </fieldset>
  <div data-pz-attached-unsupported>
  <fieldset class="persistent-zone-activity__section persistent-zone-activity__parts">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Parts.ZoneParts"}}</legend>
    <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.Multipart"}}</p>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Parts.UseMultiple"}}</label>
      <input type="checkbox" name="persistentZone.multipartEnabled" data-pz-toggle-source="multipart-editor" {{#if persistentZoneMultipartEnabled}}checked{{/if}}>
    </div>
    <div data-pz-toggle-target="multipart-editor">
      <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.Parts"}}</p>
      <div class="persistent-zone-activity__part-list">
        {{#each persistentZonePartRows as |partRow|}}
          <details class="persistent-zone-activity__part-card" data-pz-part-id="{{partRow.id}}" data-pz-disclosure-id="part:{{partRow.id}}" open>
            <summary>{{localize "PERSISTENT_ZONES.Activity.Parts.Part"}} {{partRow.number}} — {{partRow.label}}</summary>
            <div class="persistent-zone-activity__part-content">
              <input type="hidden" name="persistentZone.parts.{{partRow.index}}.id" value="{{partRow.id}}">
              <div class="persistent-zone-activity__part-subtitle">{{localize "PERSISTENT_ZONES.Activity.Parts.Identity"}}</div>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Parts.Label"}}</label>
                <input type="text" name="persistentZone.parts.{{partRow.index}}.label" value="{{partRow.label}}" required data-pz-part-field="label">
                <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.PartLabel"}}</p>
              </div>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Parts.Role"}}</label>
                <select name="persistentZone.parts.{{partRow.index}}.role" data-pz-part-field="role">
                  {{#each partRow.roleOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}}</option>
                  {{/each}}
                </select>
                <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.PartRole"}}</p>
              </div>
              <div class="persistent-zone-activity__part-subtitle persistent-zone-activity__part-subtitle--geometry">{{localize "PERSISTENT_ZONES.Activity.Sections.Geometry"}}</div>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Parts.GeometryType"}}</label>
                <select name="persistentZone.parts.{{partRow.index}}.geometry.type" data-pz-part-field="geometry.type">
                  {{#each partRow.geometryTypeOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}} {{#if option.invalid}}disabled{{/if}}>{{localize option.label}}</option>
                  {{/each}}
                </select>
                <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.PartGeometry"}}</p>
              </div>
              {{#if partRow.geometryCompatibilityWarning}}
                <p class="hint notification warning persistent-zone-activity__compatibility-warning">{{localize "PERSISTENT_ZONES.Activity.Parts.IncompatibleMainGeometry"}}</p>
              {{/if}}
              <div class="persistent-zone-activity__part-geometry" data-pz-part-derived-geometry {{#unless partRow.derivedGeometry}}hidden{{/unless}}>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Parts.ReferencePart"}}</label>
                  <select name="persistentZone.parts.{{partRow.index}}.geometry.referencePartId" data-pz-part-field="geometry.referencePartId" {{#unless partRow.derivedGeometry}}disabled{{/unless}}>
                    {{#each partRow.referenceOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}} {{#if option.invalid}}disabled{{/if}}>{{localize option.label}}</option>
                    {{/each}}
                  </select>
                  <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.ReferencePart"}}</p>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Parts.Side"}}</label>
                  <select name="persistentZone.parts.{{partRow.index}}.geometry.side" data-pz-part-field="geometry.side" {{#unless partRow.derivedGeometry}}disabled{{/unless}}>
                    {{#each partRow.sideOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}}</option>
                    {{/each}}
                  </select>
                  {{#if (eq partRow.geometryType "side-of-line")}}
                    <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.LineSide"}}</p>
                  {{else}}
                    <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RingSide"}}</p>
                  {{/if}}
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Parts.Gap"}}</label>
                  <input type="number" name="persistentZone.parts.{{partRow.index}}.geometry.gap" value="{{partRow.gap}}" min="0" step="any" data-pz-part-field="geometry.gap" {{#unless partRow.derivedGeometry}}disabled{{/unless}}>
                  <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.PartGap"}}</p>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Parts.Width"}}</label>
                  <input type="number" name="persistentZone.parts.{{partRow.index}}.geometry.width" value="{{partRow.width}}" min="0.000001" step="any" data-pz-part-field="geometry.width" {{#unless partRow.derivedGeometry}}disabled{{/unless}}>
                  <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.PartWidth"}}</p>
                </div>
              </div>
              <div class="persistent-zone-activity__part-subtitle">{{localize "PERSISTENT_ZONES.Activity.Elevation.Title"}}</div>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Elevation.Inherit"}}</label>
                <input type="checkbox" name="persistentZone.parts.{{partRow.index}}.elevation.inherit" data-pz-part-field="elevation.inherit" data-pz-part-elevation-inherit {{#if partRow.elevation.inherit}}checked{{/if}}>
              </div>
              <div data-pz-part-elevation-override {{#if partRow.elevation.inherit}}hidden{{/if}}>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Elevation.EnabledPart"}}</label>
                  <input type="checkbox" name="persistentZone.parts.{{partRow.index}}.elevation.enabled" data-pz-part-field="elevation.enabled" data-pz-part-elevation-enabled {{#if partRow.elevation.enabled}}checked{{/if}}>
                </div>
                <div data-pz-part-elevation-bounds {{#unless partRow.elevation.enabled}}hidden{{/unless}}>
                  <input type="hidden" name="persistentZone.parts.{{partRow.index}}.elevation.units" data-pz-part-field="elevation.units" value="{{partRow.elevation.units}}">
                  <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Elevation.Bottom"}} ({{partRow.elevation.unitLabel}})</label><input type="number" step="any" name="persistentZone.parts.{{partRow.index}}.elevation.bottom" data-pz-part-field="elevation.bottom" value="{{partRow.elevation.bottom}}"></div>
                  <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Elevation.Top"}} ({{partRow.elevation.unitLabel}})</label><input type="number" step="any" name="persistentZone.parts.{{partRow.index}}.elevation.top" data-pz-part-field="elevation.top" value="{{partRow.elevation.top}}"></div>
                  <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Elevation.TopInclusive"}}</label><input type="checkbox" name="persistentZone.parts.{{partRow.index}}.elevation.topInclusive" data-pz-part-field="elevation.topInclusive" {{#if partRow.elevation.topInclusive}}checked{{/if}}><p class="hint">{{localize "PERSISTENT_ZONES.Activity.Elevation.TopInclusiveHint"}}</p></div>
                </div>
              </div>
              {{#if ../persistentZoneUsesActiveTerrain}}
              <div class="persistent-zone-activity__part-subtitle">{{localize "PERSISTENT_ZONES.Activity.Sections.Terrain"}}</div>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.MovementCost"}}</label>
                <input type="checkbox" name="persistentZone.parts.{{partRow.index}}.terrain.enabled" data-pz-part-field="terrain.enabled" {{#if partRow.terrainEnabled}}checked{{/if}}>
                <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TerrainPart"}}</p>
              </div>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TerrainMultiplier"}}</label>
                <input type="number" min="1" max="5" step="0.25" name="persistentZone.parts.{{partRow.index}}.terrain.multiplier" data-pz-part-field="terrain.multiplier" value="{{partRow.terrainMultiplier}}">
              </div>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TerrainTargets"}}</label>
                <select name="persistentZone.parts.{{partRow.index}}.terrain.targetFilter.mode" data-pz-part-field="terrain.targetFilter.mode">
                  {{selectOptions ../persistentZoneChoices.terrainTargetFilters selected=partRow.terrainTargetFilter localize=true}}
                </select>
              </div>
              {{/if}}
              <details class="persistent-zone-activity__part-trigger-section" data-pz-part-trigger-section data-pz-disclosure-id="part:{{partRow.id}}:triggers">
                <summary class="persistent-zone-activity__part-subtitle persistent-zone-activity__part-subtitle--triggers">
                  <span class="persistent-zone-activity__trigger-summary-title">{{localize "PERSISTENT_ZONES.Activity.Sections.Triggers"}}</span>
                  <span class="persistent-zone-activity__trigger-summary-lines" data-pz-part-trigger-summary-lines>
                    {{#each partRow.triggerSummary as |line|}}<span class="persistent-zone-activity__trigger-summary-line">{{line}}</span>{{/each}}
                  </span>
                </summary>
                <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.PartTriggers"}}</p>
                <div class="persistent-zone-activity__part-trigger-editor" data-pz-part-trigger-editor></div>
              </details>
              <div class="persistent-zone-activity__part-actions">
                <button type="button" data-pz-multipart-action="remove" data-pz-part-id="{{partRow.id}}">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                  {{localize "PERSISTENT_ZONES.Activity.Parts.RemovePart"}}
                </button>
              </div>
            </div>
          </details>
        {{/each}}
      </div>
      <div class="persistent-zone-activity__part-actions">
        <button type="button" data-pz-multipart-action="add">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{localize "PERSISTENT_ZONES.Activity.Parts.AddPart"}}
        </button>
      </div>
    </div>
  </fieldset>
  </div>

  <fieldset class="persistent-zone-activity__section persistent-zone-activity__geometry">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Geometry"}}</legend>
    <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.MainGeometry"}}</p>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.Shape"}}</label>
      <select name="persistentZone.geometry.type">
        {{selectOptions persistentZoneChoices.geometryTypes selected=persistentZone.geometry.type localize=true}}
      </select>
    </div>
    <div data-pz-geometry="circle emanation">
      <div class="form-group">
        {{#if (eq persistentZone.geometry.type "emanation")}}
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.EmanationRadius"}} ({{persistentZoneGeometryUnitLabel}})</label>
        {{else}}
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.CircleRadius"}} ({{persistentZoneGeometryUnitLabel}})</label>
        {{/if}}
        <input type="number" name="persistentZone.geometry.radius" value="{{persistentZone.geometry.radius}}" min="0" step="any">
        {{#if (eq persistentZone.geometry.type "emanation")}}
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.EmanationRadius"}}</p>
        {{else}}
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.CircleRadius"}}</p>
        {{/if}}
      </div>
    </div>
    <div data-pz-geometry="rectangle">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RectangleWidth"}} ({{persistentZoneGeometryUnitLabel}})</label>
        <input type="number" name="persistentZone.geometry.width" value="{{persistentZone.geometry.width}}" min="0" step="any">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RectangleHeight"}} ({{persistentZoneGeometryUnitLabel}})</label>
        <input type="number" name="persistentZone.geometry.height" value="{{persistentZone.geometry.height}}" min="0" step="any">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RectangleUnits"}}</label>
        <select name="persistentZone.geometry.units">
          <option value="scene" {{#if (eq persistentZone.geometry.units "scene")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DistanceUnits.Scene"}}</option>
          <option value="ft" {{#if (eq persistentZone.geometry.units "ft")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DistanceUnits.Feet"}}</option>
          <option value="m" {{#if (eq persistentZone.geometry.units "m")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DistanceUnits.Meters"}}</option>
        </select>
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RectangleDimensions"}}</p>
      </div>
    </div>
    <div data-pz-geometry="ring">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RingReferenceRadius"}} ({{persistentZoneGeometryUnitLabel}})</label>
        <input type="number" name="persistentZone.geometry.ringReferenceRadius" value="{{persistentZone.geometry.ringReferenceRadius}}" min="0" step="any">
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RingReferenceRadius"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RingInnerWidth"}} ({{persistentZoneGeometryUnitLabel}})</label>
        <input type="number" name="persistentZone.geometry.ringInnerWidth" value="{{persistentZone.geometry.ringInnerWidth}}" min="0" step="any">
        {{#if persistentZoneRingUsesLegacySemantics}}
          <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.LegacyRingInnerWidth"}}</p>
        {{else}}
          <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RingInnerWidth"}}</p>
        {{/if}}
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RingOuterWidth"}} ({{persistentZoneGeometryUnitLabel}})</label>
        <input type="number" name="persistentZone.geometry.ringOuterWidth" value="{{persistentZone.geometry.ringOuterWidth}}" min="0" step="any">
        {{#if persistentZoneRingUsesLegacySemantics}}
          <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.LegacyRingOuterWidth"}}</p>
        {{else}}
          <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RingOuterWidth"}}</p>
        {{/if}}
      </div>
      {{#if persistentZoneRingUsesLegacySemantics}}
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.ReferenceRadiusMode"}}</label>
        <select name="persistentZone.geometry.referenceRadiusMode">
          {{selectOptions persistentZoneChoices.referenceRadiusModes selected=persistentZone.geometry.referenceRadiusMode localize=true}}
        </select>
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RingRadiusMode"}}</p>
      </div>
      {{/if}}
    </div>
    <div data-pz-geometry="wall">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.WallLength"}} ({{persistentZoneGeometryUnitLabel}})</label>
        <input type="number" name="persistentZone.geometry.wallLength" value="{{persistentZone.geometry.wallLength}}" min="0" step="any">
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.WallLength"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.WallThickness"}} ({{persistentZoneGeometryUnitLabel}})</label>
        <input type="number" name="persistentZone.geometry.wallThickness" value="{{persistentZone.geometry.wallThickness}}" min="0" step="any">
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.WallThickness"}}</p>
      </div>
    </div>
    <div data-pz-geometry="circle emanation">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RadiusScaling"}}</label>
        <select name="persistentZone.geometry.scaling.mode" data-pz-radius-scaling-mode>
          <option value="none" {{#if (eq persistentZone.geometry.scaling.mode "none")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.RadiusScaling.None"}}</option>
          <option value="per-level" {{#if (eq persistentZone.geometry.scaling.mode "per-level")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.RadiusScaling.PerLevel"}}</option>
        </select>
      </div>
      <div data-pz-radius-scaling-fields {{#unless (eq persistentZone.geometry.scaling.mode "per-level")}}hidden{{/unless}}>
        <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Fields.RadiusScalingBaseLevelMode"}}</label><select name="persistentZone.geometry.scaling.baseLevelMode"><option value="item" {{#if (eq persistentZone.geometry.scaling.baseLevelMode "item")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.RadiusScaling.ItemLevel"}}</option><option value="fixed" {{#if (eq persistentZone.geometry.scaling.baseLevelMode "fixed")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.RadiusScaling.FixedLevel"}}</option></select></div>
        <div class="form-group" data-pz-radius-scaling-fixed-level {{#unless (eq persistentZone.geometry.scaling.baseLevelMode "fixed")}}hidden{{/unless}}><label>{{localize "PERSISTENT_ZONES.Activity.Fields.RadiusScalingBaseLevel"}}</label><input type="number" name="persistentZone.geometry.scaling.baseLevel" min="1" step="1" value="{{persistentZone.geometry.scaling.baseLevel}}"></div>
        <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Fields.RadiusScalingPerLevel"}} ({{persistentZoneGeometryUnitLabel}})</label><input type="number" name="persistentZone.geometry.scaling.radiusPerLevel" min="0" step="any" value="{{persistentZone.geometry.scaling.radiusPerLevel}}"></div>
      </div>
    </div>
    <div class="persistent-zone-activity__part-subtitle">{{localize "PERSISTENT_ZONES.Activity.Elevation.Title"}}</div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Elevation.Enabled"}}</label>
      <input type="checkbox" name="persistentZone.elevation.enabled" data-pz-elevation-enabled {{#if persistentZone.elevation.enabled}}checked{{/if}}>
    </div>
    <div data-pz-elevation-bounds {{#unless persistentZone.elevation.enabled}}hidden{{/unless}}>
      <input type="hidden" name="persistentZone.elevation.units" value="{{persistentZone.elevation.units}}">
      <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Elevation.Bottom"}} ({{persistentZone.elevation.unitLabel}})</label><input type="number" step="any" name="persistentZone.elevation.bottom" value="{{persistentZone.elevation.bottom}}"></div>
      <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Elevation.Top"}} ({{persistentZone.elevation.unitLabel}})</label><input type="number" step="any" name="persistentZone.elevation.top" value="{{persistentZone.elevation.top}}"></div>
      <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Elevation.TopInclusive"}}</label><input type="checkbox" name="persistentZone.elevation.topInclusive" {{#if persistentZone.elevation.topInclusive}}checked{{/if}}><p class="hint">{{localize "PERSISTENT_ZONES.Activity.Elevation.TopInclusiveHint"}}</p></div>
    </div>
    <div class="persistent-zone-activity__part-subtitle">{{localize "PERSISTENT_ZONES.Activity.Obscuration.Title"}}</div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Obscuration.Mode"}}</label>
      <select name="persistentZone.obscuration.mode">
        {{selectOptions persistentZoneChoices.obscurationModes selected=persistentZone.obscuration.mode localize=true}}
      </select>
    </div>
    <div class="persistent-zone-activity__part-subtitle">{{localize "PERSISTENT_ZONES.Activity.Obstacles.Title"}}</div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Obstacles.Enabled"}}</label>
      <input type="checkbox" data-pz-obstacles-enabled {{#if (eq persistentZone.obstacles.mode "wall-restricted")}}checked{{/if}}>
      <input type="hidden" name="persistentZone.obstacles.mode" data-pz-obstacles-mode value="{{persistentZone.obstacles.mode}}">
    </div>
    <div data-pz-obstacles-fields {{#unless (eq persistentZone.obstacles.mode "wall-restricted")}}hidden{{/unless}}>
      <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Obstacles.RestrictionType"}}</label><select name="persistentZone.obstacles.restrictionType">{{selectOptions persistentZoneChoices.obstacleTypes selected=persistentZone.obstacles.restrictionType localize=true}}</select></div>
      <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Obstacles.Priority"}}</label><input type="number" min="0" step="1" name="persistentZone.obstacles.priority" value="{{persistentZone.obstacles.priority}}"></div>
      <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Obstacles.Hint"}}</p>
    </div>
  </fieldset>

  {{#unless persistentZoneMultipartEnabled}}
  <fieldset class="persistent-zone-activity__section persistent-zone-activity__defaults">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Triggers"}}</legend>
    <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggersSingle"}}</p>
    <div data-pz-mono-trigger-editor></div>
  </fieldset>
  {{/unless}}

  {{#if persistentZoneUsesActiveTerrain}}
  {{#unless persistentZoneMultipartEnabled}}
  <fieldset class="persistent-zone-activity__section">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Terrain"}}</legend>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.MovementCost"}}</label>
      <input type="checkbox" name="persistentZone.terrain.enabled" {{#if persistentZone.terrain.enabled}}checked{{/if}}>
      <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TerrainZone"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TerrainMultiplier"}}</label>
      <input type="number" min="1" max="5" step="0.25" name="persistentZone.terrain.multiplier" value="{{persistentZone.terrain.multiplier}}">
    </div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TerrainTargets"}}</label>
      <select name="persistentZone.terrain.targetFilter.mode">
        {{selectOptions persistentZoneChoices.triggerTargetFilters selected=persistentZone.terrain.targetFilter.mode localize=true}}
      </select>
    </div>
  </fieldset>
  {{/unless}}
  {{/if}}

  <fieldset class="persistent-zone-activity__section">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.AutomaticMovement"}}</legend>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.AutomaticMovementEnabled"}}</label>
      <input type="checkbox" name="persistentZone.translation.enabled" data-pz-toggle-source="automatic-movement" {{#if persistentZoneTranslation.enabled}}checked{{/if}}>
    </div>
    <div data-pz-toggle-target="automatic-movement">
      <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.AutomaticMovement"}}</p>
      <input type="hidden" name="persistentZone.translation.trigger" value="source-turn-start">
      <input type="hidden" name="persistentZone.translation.direction" value="away-from-source">
      <input type="hidden" name="persistentZone.translation.units" value="{{persistentZoneTranslation.units}}">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.AutomaticMovement.Timing"}}</label>
        <input type="text" disabled value="{{persistentZoneTranslation.triggerLabel}}">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.AutomaticMovementDistance"}} ({{persistentZoneTranslation.unitLabel}})</label>
        <input type="number" min="0" step="any" name="persistentZone.translation.distance" value="{{persistentZoneTranslation.distance}}">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.AutomaticMovement.Direction"}}</label>
        <input type="text" disabled value="{{persistentZoneTranslation.directionLabel}}">
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.AutomaticMovementDirection"}}</p>
      </div>
      <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.AutomaticMovementLimits"}}</p>
    </div>
  </fieldset>

  <fieldset class="persistent-zone-activity__section" data-pz-attached-unsupported>
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.ControlledMovement"}}</legend>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.ControlledMovementEnabled"}}</label>
      <input type="checkbox" name="persistentZone.controlledMovement.enabled" data-pz-toggle-source="controlled-movement" {{#if persistentZoneControlledMovement.enabled}}checked{{/if}}>
    </div>
    <div data-pz-toggle-target="controlled-movement">
      <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.ControlledMovement"}}</p>
      <input type="hidden" name="persistentZone.controlledMovement.units" value="{{persistentZoneControlledMovement.units}}">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.ControlledMovementMaxDistance"}} ({{persistentZoneControlledMovement.unitLabel}})</label>
        <input type="number" min="0" step="any" name="persistentZone.controlledMovement.maxDistance" value="{{persistentZoneControlledMovement.maxDistance}}">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.ControlledMovementPhysicalRadius"}} ({{persistentZoneControlledMovement.unitLabel}})</label>
        <input type="number" min="0" step="any" name="persistentZone.controlledMovement.physicalRadius" value="{{persistentZoneControlledMovement.physicalRadius}}">
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.ControlledMovementPhysicalBody"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.ControlledMovementLinkedActivity"}}</label>
        <div class="form-fields">
          <input type="text" disabled value="{{persistentZoneControlledMovement.linkedActivityDisplay}}">
          <button type="button" data-pz-ensure-controlled-movement>{{localize "PERSISTENT_ZONES.Activity.ControlledMovement.Ensure"}}</button>
          {{#if persistentZoneControlledMovement.activationActivityId}}<button type="button" data-pz-open-controlled-movement>{{localize "PERSISTENT_ZONES.Activity.ControlledMovement.Open"}}</button>{{/if}}
        </div>
        <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.ControlledMovementLinkedActivity"}}</p>
      </div>
    </div>
  </fieldset>

  <fieldset class="persistent-zone-activity__section">
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Movement"}}</legend>
    <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.Movement"}}</p>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.MovementInterruption"}}</label>
      <select name="persistentZone.movement.interruptionMode">
        {{selectOptions persistentZoneChoices.interruptionModes selected=persistentZone.movement.interruptionMode localize=true}}
      </select>
    </div>
    <div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.UI.Fields.MovementMode"}}</label>
        <select name="persistentZone.movement.movementMode">
          {{selectOptions persistentZoneChoices.movementModes selected=persistentZone.movement.movementMode localize=true}}
        </select>
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.UI.Fields.StepMode"}}</label>
        <select name="persistentZone.movement.stepMode">
          {{selectOptions persistentZoneChoices.stepModes selected=persistentZone.movement.stepMode localize=true}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.MovementDistanceStep"}}</label>
      <input type="number" name="persistentZone.movement.distanceStep" value="{{persistentZone.movement.distanceStep}}" min="0.000001" step="any">
    </div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.MovementDistanceUnits"}}</label>
      <select name="persistentZone.movement.units">
        <option value="scene" {{#if (eq persistentZone.movement.units "scene")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DistanceUnits.Scene"}}</option>
        <option value="ft" {{#if (eq persistentZone.movement.units "ft")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DistanceUnits.Feet"}}</option>
        <option value="m" {{#if (eq persistentZone.movement.units "m")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DistanceUnits.Meters"}}</option>
      </select>
    </div>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.AccumulateMovementRemainder"}}</label>
      <input type="checkbox" name="persistentZone.movement.accumulateRemainder" {{#if persistentZone.movement.accumulateRemainder}}checked{{/if}}>
    </div>
  </fieldset>

  <fieldset class="persistent-zone-activity__section" data-pz-attached-unsupported>
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.LinkedWalls"}}</legend>
    <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.LinkedWalls"}}</p>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.CreateWalls"}}</label>
      <input type="checkbox" name="persistentZone.linkedWalls.enabled" data-pz-toggle-source="linked-walls" {{#if persistentZone.linkedWalls.enabled}}checked{{/if}}>
    </div>
    <div data-pz-toggle-target="linked-walls">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.UI.Fields.LinkedWallsPreset"}}</label>
        <select name="persistentZone.linkedWalls.preset">
          {{#each persistentZoneWallPresets as |option|}}
            <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group" data-pz-linked-wall-geometry>
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallGeometry"}}</label>
        <select name="persistentZone.linkedWalls.geometry">
          {{selectOptions persistentZoneChoices.linkedWallGeometries selected=persistentZone.linkedWalls.geometry localize=true}}
        </select>
      </div>
      <div data-pz-linked-wall-custom>
        <div class="form-group">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallMovement"}}</label>
          <select name="persistentZone.linkedWalls.move">
            {{selectOptions persistentZoneChoices.linkedWallMovementTypes selected=persistentZone.linkedWalls.move localize=true}}
          </select>
        </div>
        <div class="form-group">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallSight"}}</label>
          <select name="persistentZone.linkedWalls.sight">
            {{selectOptions persistentZoneChoices.linkedWallSenseTypes selected=persistentZone.linkedWalls.sight localize=true}}
          </select>
        </div>
        <div class="form-group" data-pz-linked-wall-threshold="sight">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallThreshold"}} ({{persistentZoneLinkedDistanceUnitLabel}})</label>
          <input type="number" name="persistentZone.linkedWalls.threshold.sight" value="{{persistentZone.linkedWalls.threshold.sight}}" min="0" step="any">
        </div>
        <div class="form-group">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallLight"}}</label>
          <select name="persistentZone.linkedWalls.light">
            {{selectOptions persistentZoneChoices.linkedWallSenseTypes selected=persistentZone.linkedWalls.light localize=true}}
          </select>
        </div>
        <div class="form-group" data-pz-linked-wall-threshold="light">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallThreshold"}} ({{persistentZoneLinkedDistanceUnitLabel}})</label>
          <input type="number" name="persistentZone.linkedWalls.threshold.light" value="{{persistentZone.linkedWalls.threshold.light}}" min="0" step="any">
        </div>
        <div class="form-group">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallSound"}}</label>
          <select name="persistentZone.linkedWalls.sound">
            {{selectOptions persistentZoneChoices.linkedWallSenseTypes selected=persistentZone.linkedWalls.sound localize=true}}
          </select>
        </div>
        <div class="form-group" data-pz-linked-wall-threshold="sound">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallThreshold"}} ({{persistentZoneLinkedDistanceUnitLabel}})</label>
          <input type="number" name="persistentZone.linkedWalls.threshold.sound" value="{{persistentZone.linkedWalls.threshold.sound}}" min="0" step="any">
        </div>
        <div class="form-group" data-pz-linked-wall-direction>
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedWallDirection"}}</label>
          <select name="persistentZone.linkedWalls.dir">
            {{selectOptions persistentZoneChoices.linkedWallDirections selected=persistentZone.linkedWalls.dir localize=true}}
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.WallHeight"}} ({{persistentZoneLinkedDistanceUnitLabel}})</label>
        <input type="number" name="persistentZone.linkedWalls.height" value="{{persistentZone.linkedWalls.height}}" min="0" step="any">
      </div>
    </div>
  </fieldset>

  <fieldset class="persistent-zone-activity__section" data-pz-attached-unsupported>
    <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.LinkedLights"}}</legend>
    <p class="hint persistent-zone-activity__section-hint">{{localize "PERSISTENT_ZONES.Activity.Help.LinkedLights"}}</p>
    <div class="form-group">
      <label>{{localize "PERSISTENT_ZONES.Activity.Fields.CreateLights"}}</label>
      <input type="checkbox" name="persistentZone.linkedLights.enabled" data-pz-toggle-source="linked-lights" {{#if persistentZone.linkedLights.enabled}}checked{{/if}}>
    </div>
    <div data-pz-toggle-target="linked-lights">
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.UI.Fields.LinkedLightPreset"}}</label>
        <select name="persistentZone.linkedLights.preset">
          {{#each persistentZoneLightPresets as |option|}}
            <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LightColor"}}</label>
        <input type="color" name="persistentZone.linkedLights.color" value="{{persistentZone.linkedLights.color}}">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.UI.Fields.LinkedLightBright"}} ({{persistentZoneLinkedDistanceUnitLabel}})</label>
        <input type="number" name="persistentZone.linkedLights.bright" value="{{persistentZone.linkedLights.bright}}" min="0" step="any">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.UI.Fields.LinkedLightDim"}} ({{persistentZoneLinkedDistanceUnitLabel}})</label>
        <input type="number" name="persistentZone.linkedLights.dim" value="{{persistentZone.linkedLights.dim}}" min="0" step="any">
      </div>
      <div class="form-group">
        <label>{{localize "PERSISTENT_ZONES.Activity.Fields.LinkedLightMax"}}</label>
        <input type="number" name="persistentZone.linkedLights.max" value="{{persistentZone.linkedLights.max}}" min="1" step="1">
      </div>
    </div>
  </fieldset>
  </div>
</div>
</section>
