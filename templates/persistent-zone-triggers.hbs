    {{#each triggerRows as |triggerRow|}}
      <details class="persistent-zone-activity__trigger" data-pz-trigger="{{triggerRow.timing}}" data-pz-trigger-key="{{triggerRow.uiKey}}" data-pz-disclosure-id="trigger:{{triggerRow.uiKey}}">
        <summary class="persistent-zone-activity__trigger-summary">
          <span class="persistent-zone-activity__trigger-summary-title">{{triggerRow.label}}</span>
          <span class="persistent-zone-activity__trigger-summary-line">{{triggerRow.summary}}</span>
        </summary>
        <div class="persistent-zone-activity__trigger-content">
        <header class="persistent-zone-activity__trigger-header">
          <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TriggerEnabled"}}</label>
          <input type="checkbox" name="{{triggerRow.fieldPath}}.enabled" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.enabled"{{/if}} {{#if triggerRow.state.enabled}}checked{{/if}}>
        </header>
        {{#if (eq triggerRow.timing "onCreate")}}<p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerCreate"}}</p>{{/if}}
        {{#if (eq triggerRow.timing "enter")}}<p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerEnter"}}</p>{{/if}}
        {{#if (eq triggerRow.timing "move")}}<p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerMove"}}</p>{{/if}}
        {{#if (eq triggerRow.timing "exit")}}<p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerExit"}}</p>{{/if}}
        {{#if (eq triggerRow.timing "turnStart")}}<p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerTurnStart"}}</p>{{/if}}
        {{#if (eq triggerRow.timing "turnEnd")}}<p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerTurnEnd"}}</p>{{/if}}
        <div data-pz-trigger-details>
          <div class="form-group">
            <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TriggerTargets"}}</label>
            <select name="{{triggerRow.fieldPath}}.targetFilter.mode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.targetFilter.mode"{{/if}}>
              {{selectOptions ../persistentZoneChoices.triggerTargetFilters selected=triggerRow.state.targetFilter.mode localize=true}}
            </select>
          </div>
          <div class="form-group">
            <label>{{localize "PERSISTENT_ZONES.Activity.Fields.RequireSourceVisibility"}}</label>
            <input type="checkbox" name="{{triggerRow.fieldPath}}.requireSourceVisibility" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.requireSourceVisibility"{{/if}} {{#if triggerRow.state.requireSourceVisibility}}checked{{/if}}>
            <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RequireSourceVisibility"}}</p>
          </div>
          <div class="form-group">
            <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TriggerTargeting"}}</label>
            <select name="{{triggerRow.fieldPath}}.targeting.mode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.targeting.mode"{{/if}} data-pz-trigger-targeting>
              {{#each triggerRow.targetingOptions as |option|}}
                <option value="{{option.value}}" {{#if option.selected}}selected{{/if}} {{#if option.requiresControlledMovement}}data-pz-requires-controlled-movement{{/if}} {{#if option.unavailable}}disabled hidden{{/if}}>{{localize option.label}}</option>
              {{/each}}
            </select>
            <p class="hint" data-pz-targeting-help="physical-contact">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerTargetingPhysicalContact"}}</p>
            <p class="hint" data-pz-targeting-help="proximity">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerTargetingProximity"}}</p>
          </div>
          <div class="form-group" data-pz-proximity-distance>
            <label>{{localize "PERSISTENT_ZONES.Activity.Fields.ProximityDistance"}} ({{triggerRow.unitLabel}})</label>
            <input type="number" min="0" step="any" name="{{triggerRow.fieldPath}}.targeting.distance" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.targeting.distance"{{/if}} value="{{triggerRow.state.targeting.distance}}">
          </div>
          <div class="form-group">
            <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TriggerFrequency"}}</label>
            <select name="{{triggerRow.fieldPath}}.frequency" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.frequency"{{/if}} data-pz-frequency-source="{{triggerRow.uiKey}}">
              {{selectOptions ../persistentZoneChoices.triggerFrequencies selected=triggerRow.state.frequency localize=true}}
            </select>
          </div>
          <div class="form-group" data-pz-frequency-group="{{triggerRow.uiKey}}">
            <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TriggerFrequencyGroup"}}</label>
            <input type="text" name="{{triggerRow.fieldPath}}.frequencyGroup" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.frequencyGroup"{{/if}} value="{{triggerRow.state.frequencyGroup}}">
            <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.TriggerFrequencyGroup"}}</p>
          </div>

          <details class="persistent-zone-activity__advanced-conditions" data-pz-disclosure-id="trigger:{{triggerRow.uiKey}}:advanced-conditions">
            <summary>
              <span>{{localize "PERSISTENT_ZONES.Activity.Sections.AdvancedConditions"}}</span>
              {{#if triggerRow.advancedConditionsSummary}}<span class="persistent-zone-activity__advanced-conditions-summary">{{triggerRow.advancedConditionsSummary}}</span>{{/if}}
            </summary>
            <fieldset class="persistent-zone-activity__status-guard" data-pz-status-guard data-pz-status-guard-path="{{triggerRow.fieldPath}}.requiredAbsentStatuses" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.requiredAbsentStatuses"{{/if}} data-pz-status-guard-had-value="{{#if triggerRow.hasRequiredAbsentStatuses}}true{{else}}false{{/if}}">
              <legend>{{localize "PERSISTENT_ZONES.Activity.Fields.RequiredAbsentStatuses"}}</legend>
              <div class="persistent-zone-activity__status-guard-tags">
                {{#each triggerRow.requiredAbsentStatusTags as |status|}}
                  <span class="persistent-zone-activity__status-guard-tag">{{status.label}} <button type="button" data-pz-status-guard-remove="{{status.value}}" aria-label="{{localize "PERSISTENT_ZONES.Activity.Fields.RemoveStatus"}}">×</button></span>
                {{/each}}
              </div>
              {{#each triggerRow.requiredAbsentStatusTags as |status|}}<input type="hidden" name="{{../fieldPath}}.requiredAbsentStatuses" {{#if ../partId}}data-pz-part-field="triggers.{{../timing}}.requiredAbsentStatuses"{{/if}} value="{{status.value}}" data-pz-status-guard-value>{{/each}}
              <select data-pz-status-guard-add>
                <option value="">{{localize "PERSISTENT_ZONES.Activity.Fields.AddStatus"}}</option>
                {{#each triggerRow.requiredAbsentStatusOptions as |option|}}
                  {{#unless option.selected}}<option value="{{option.value}}">{{option.label}}</option>{{/unless}}
                {{/each}}
              </select>
              <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RequiredAbsentStatuses"}}</p>
            </fieldset>
            <fieldset class="persistent-zone-activity__status-guard" data-pz-status-guard data-pz-status-guard-path="{{triggerRow.fieldPath}}.requiredAbsentSourceStatuses" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.requiredAbsentSourceStatuses"{{/if}} data-pz-status-guard-had-value="{{#if triggerRow.hasRequiredAbsentSourceStatuses}}true{{else}}false{{/if}}">
              <legend>{{localize "PERSISTENT_ZONES.Activity.Fields.RequiredAbsentSourceStatuses"}}</legend>
              <div class="persistent-zone-activity__status-guard-tags">
                {{#each triggerRow.requiredAbsentSourceStatusTags as |status|}}
                  <span class="persistent-zone-activity__status-guard-tag">{{status.label}} <button type="button" data-pz-status-guard-remove="{{status.value}}" aria-label="{{localize "PERSISTENT_ZONES.Activity.Fields.RemoveStatus"}}">×</button></span>
                {{/each}}
              </div>
              {{#each triggerRow.requiredAbsentSourceStatusTags as |status|}}<input type="hidden" name="{{../fieldPath}}.requiredAbsentSourceStatuses" {{#if ../partId}}data-pz-part-field="triggers.{{../timing}}.requiredAbsentSourceStatuses"{{/if}} value="{{status.value}}" data-pz-status-guard-value>{{/each}}
              <select data-pz-status-guard-add>
                <option value="">{{localize "PERSISTENT_ZONES.Activity.Fields.AddStatus"}}</option>
                {{#each triggerRow.requiredAbsentSourceStatusOptions as |option|}}
                  {{#unless option.selected}}<option value="{{option.value}}">{{option.label}}</option>{{/unless}}
                {{/each}}
              </select>
              <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.RequiredAbsentSourceStatuses"}}</p>
            </fieldset>
          </details>

          <fieldset class="persistent-zone-activity__trigger-effects">
            <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Effects"}}</legend>
            <div class="form-group">
              <label>{{localize "PERSISTENT_ZONES.UI.Fields.TriggerMode"}}</label>
              <select name="{{triggerRow.fieldPath}}.mode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.mode"{{/if}}>
                {{selectOptions ../persistentZoneChoices.triggerModes selected=triggerRow.state.mode localize=true}}
              </select>
            </div>

          <div data-pz-mode="simple-effect">
            <fieldset>
              <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Damage"}}</legend>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageEnabled"}}</label>
                <input type="checkbox" name="{{triggerRow.fieldPath}}.simpleEffect.damage.enabled" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.damage.enabled"{{/if}} data-pz-toggle-source="{{triggerRow.uiKey}}-damage" {{#if triggerRow.state.simpleEffect.damage.enabled}}checked{{/if}}>
              </div>
              <div data-pz-toggle-target="{{triggerRow.uiKey}}-damage">
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.UI.Fields.DamageFormula"}}</label>
                  <input type="text" name="{{triggerRow.fieldPath}}.simpleEffect.damage.formula" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.damage.formula"{{/if}} value="{{triggerRow.state.simpleEffect.damage.formula}}">
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.UI.Fields.DamageType"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.damage.type" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.damage.type"{{/if}}>
                    {{#each ../persistentZoneDamageTypes as |option|}}
                      <option value="{{option.value}}" {{#if (eq option.value triggerRow.state.simpleEffect.damage.type)}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScaling"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.damage.scaling.mode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.damage.scaling.mode"{{/if}}>
                    <option value="none" {{#if (eq triggerRow.state.simpleEffect.damage.scaling.mode "none")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.None"}}</option>
                    <option value="per-level" {{#if (eq triggerRow.state.simpleEffect.damage.scaling.mode "per-level")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.PerLevel"}}</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingBaseLevelMode"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.damage.scaling.baseLevelMode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.damage.scaling.baseLevelMode"{{/if}}>
                    <option value="item" {{#if (eq triggerRow.state.simpleEffect.damage.scaling.baseLevelMode "item")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.ItemLevel"}}</option>
                    <option value="fixed" {{#if (eq triggerRow.state.simpleEffect.damage.scaling.baseLevelMode "fixed")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.FixedLevel"}}</option>
                  </select>
                </div>
                {{#if (eq triggerRow.state.simpleEffect.damage.scaling.baseLevelMode "fixed")}}
                  <div class="form-group">
                    <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingBaseLevel"}}</label>
                    <input type="number" min="1" step="1" name="{{triggerRow.fieldPath}}.simpleEffect.damage.scaling.baseLevel" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.damage.scaling.baseLevel"{{/if}} value="{{triggerRow.state.simpleEffect.damage.scaling.baseLevel}}">
                  </div>
                {{/if}}
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingPerLevelFormula"}}</label>
                  <input type="text" name="{{triggerRow.fieldPath}}.simpleEffect.damage.scaling.perLevelFormula" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.damage.scaling.perLevelFormula"{{/if}} value="{{triggerRow.state.simpleEffect.damage.scaling.perLevelFormula}}">
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Healing"}}</legend>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.HealingEnabled"}}</label>
                <input type="checkbox" name="{{triggerRow.fieldPath}}.simpleEffect.healing.enabled" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.healing.enabled"{{/if}} data-pz-toggle-source="{{triggerRow.uiKey}}-healing" {{#if triggerRow.state.simpleEffect.healing.enabled}}checked{{/if}}>
              </div>
              <div data-pz-toggle-target="{{triggerRow.uiKey}}-healing">
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.HealingFormula"}}</label>
                  <input type="text" name="{{triggerRow.fieldPath}}.simpleEffect.healing.formula" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.healing.formula"{{/if}} value="{{triggerRow.state.simpleEffect.healing.formula}}">
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScaling"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.healing.scaling.mode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.healing.scaling.mode"{{/if}}>
                    <option value="none" {{#if (eq triggerRow.state.simpleEffect.healing.scaling.mode "none")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.None"}}</option>
                    <option value="per-level" {{#if (eq triggerRow.state.simpleEffect.healing.scaling.mode "per-level")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.PerLevel"}}</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingBaseLevelMode"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.healing.scaling.baseLevelMode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.healing.scaling.baseLevelMode"{{/if}}>
                    <option value="item" {{#if (eq triggerRow.state.simpleEffect.healing.scaling.baseLevelMode "item")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.ItemLevel"}}</option>
                    <option value="fixed" {{#if (eq triggerRow.state.simpleEffect.healing.scaling.baseLevelMode "fixed")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.FixedLevel"}}</option>
                  </select>
                </div>
                {{#if (eq triggerRow.state.simpleEffect.healing.scaling.baseLevelMode "fixed")}}
                  <div class="form-group">
                    <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingBaseLevel"}}</label>
                    <input type="number" min="1" step="1" name="{{triggerRow.fieldPath}}.simpleEffect.healing.scaling.baseLevel" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.healing.scaling.baseLevel"{{/if}} value="{{triggerRow.state.simpleEffect.healing.scaling.baseLevel}}">
                  </div>
                {{/if}}
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingPerLevelFormula"}}</label>
                  <input type="text" name="{{triggerRow.fieldPath}}.simpleEffect.healing.scaling.perLevelFormula" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.healing.scaling.perLevelFormula"{{/if}} value="{{triggerRow.state.simpleEffect.healing.scaling.perLevelFormula}}">
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.TemporaryHitPoints"}}</legend>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TempHpEnabled"}}</label>
                <input type="checkbox" name="{{triggerRow.fieldPath}}.simpleEffect.temporaryHitPoints.enabled" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.temporaryHitPoints.enabled"{{/if}} data-pz-toggle-source="{{triggerRow.uiKey}}-temphp" {{#if triggerRow.state.simpleEffect.temporaryHitPoints.enabled}}checked{{/if}}>
              </div>
              <div data-pz-toggle-target="{{triggerRow.uiKey}}-temphp">
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.TempHpFormula"}}</label>
                  <input type="text" name="{{triggerRow.fieldPath}}.simpleEffect.temporaryHitPoints.formula" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.temporaryHitPoints.formula"{{/if}} value="{{triggerRow.state.simpleEffect.temporaryHitPoints.formula}}">
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScaling"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.temporaryHitPoints.scaling.mode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.temporaryHitPoints.scaling.mode"{{/if}}>
                    <option value="none" {{#if (eq triggerRow.state.simpleEffect.temporaryHitPoints.scaling.mode "none")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.None"}}</option>
                    <option value="per-level" {{#if (eq triggerRow.state.simpleEffect.temporaryHitPoints.scaling.mode "per-level")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.PerLevel"}}</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingBaseLevelMode"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.temporaryHitPoints.scaling.baseLevelMode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.temporaryHitPoints.scaling.baseLevelMode"{{/if}}>
                    <option value="item" {{#if (eq triggerRow.state.simpleEffect.temporaryHitPoints.scaling.baseLevelMode "item")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.ItemLevel"}}</option>
                    <option value="fixed" {{#if (eq triggerRow.state.simpleEffect.temporaryHitPoints.scaling.baseLevelMode "fixed")}}selected{{/if}}>{{localize "PERSISTENT_ZONES.Activity.DamageScaling.FixedLevel"}}</option>
                  </select>
                </div>
                {{#if (eq triggerRow.state.simpleEffect.temporaryHitPoints.scaling.baseLevelMode "fixed")}}
                  <div class="form-group">
                    <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingBaseLevel"}}</label>
                    <input type="number" min="1" step="1" name="{{triggerRow.fieldPath}}.simpleEffect.temporaryHitPoints.scaling.baseLevel" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.temporaryHitPoints.scaling.baseLevel"{{/if}} value="{{triggerRow.state.simpleEffect.temporaryHitPoints.scaling.baseLevel}}">
                  </div>
                {{/if}}
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.DamageScalingPerLevelFormula"}}</label>
                  <input type="text" name="{{triggerRow.fieldPath}}.simpleEffect.temporaryHitPoints.scaling.perLevelFormula" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.temporaryHitPoints.scaling.perLevelFormula"{{/if}} value="{{triggerRow.state.simpleEffect.temporaryHitPoints.scaling.perLevelFormula}}">
                </div>
              </div>
            </fieldset>

              <fieldset>
                <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Save"}}</legend>
              <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.Save"}}</p>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.SaveEnabled"}}</label>
                <input type="checkbox" name="{{triggerRow.fieldPath}}.simpleEffect.save.enabled" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.save.enabled"{{/if}} data-pz-toggle-source="{{triggerRow.uiKey}}-save" {{#if triggerRow.state.simpleEffect.save.enabled}}checked{{/if}}>
              </div>
              <div data-pz-toggle-target="{{triggerRow.uiKey}}-save">
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.UI.Fields.SaveAbility"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.save.ability" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.save.ability"{{/if}}>
                    {{#each ../persistentZoneAbilities as |option|}}
                      <option value="{{option.value}}" {{#if (eq option.value triggerRow.state.simpleEffect.save.ability)}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.UI.Fields.SaveDcMode"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.save.dcMode" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.save.dcMode"{{/if}}>
                    {{selectOptions ../persistentZoneChoices.saveDcModes selected=triggerRow.state.simpleEffect.save.dcMode localize=true}}
                  </select>
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.UI.Fields.SaveDc"}}</label>
                  <input type="number" name="{{triggerRow.fieldPath}}.simpleEffect.save.dc" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.save.dc"{{/if}} value="{{triggerRow.state.simpleEffect.save.dc}}" min="1" step="1">
                </div>
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.SaveResult"}}</label>
                  <select name="{{triggerRow.fieldPath}}.simpleEffect.save.onSave" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.save.onSave"{{/if}}>
                    {{selectOptions ../persistentZoneChoices.saveResults selected=triggerRow.state.simpleEffect.save.onSave localize=true}}
                  </select>
                  <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.SaveResult"}}</p>
                </div>
                </div>
                <div class="form-group"><label>{{localize "PERSISTENT_ZONES.Activity.Fields.EndConcentration"}}</label><input type="checkbox" name="{{triggerRow.fieldPath}}.simpleEffect.endConcentration.enabled" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.endConcentration.enabled"{{/if}} {{#if triggerRow.state.simpleEffect.endConcentration.enabled}}checked{{/if}}></div>
              </fieldset>

            <fieldset>
              <legend>{{localize "PERSISTENT_ZONES.Activity.Sections.Statuses"}}</legend>
              <p class="hint">{{localize "PERSISTENT_ZONES.Activity.Help.Statuses"}}</p>
              <div class="form-group">
                <label>{{localize "PERSISTENT_ZONES.Activity.Fields.StatusesEnabled"}}</label>
                <input type="checkbox" name="{{triggerRow.fieldPath}}.simpleEffect.statuses.enabled" {{#if triggerRow.partId}}data-pz-part-field="triggers.{{triggerRow.timing}}.simpleEffect.statuses.enabled"{{/if}} data-pz-toggle-source="{{triggerRow.uiKey}}-statuses" {{#if triggerRow.state.simpleEffect.statuses.enabled}}checked{{/if}}>
              </div>
              <div data-pz-toggle-target="{{triggerRow.uiKey}}-statuses">
                <div class="form-group">
                  <label>{{localize "PERSISTENT_ZONES.Activity.Fields.StatusId"}}</label>
